{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "analytics-remote"
  ],
  "scripts": {
    "dev": "concurrently -n shell,analytics -c cyan,magenta \"npm:dev:shell\" \"npm:dev:remote\"",
    "dev:shell": "rspack serve --config rspack.config.mjs",
    "dev:remote": "npm --prefix analytics-remote run dev",
    "build": "npm run build:remote && tsc -b && rspack build --config rspack.config.mjs",
    "build:remote": "npm --prefix analytics-remote run build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@module-federation/enhanced": "^0.21.6",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@reduxjs/toolkit": "^2.11.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-redux": "^9.2.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rspack/cli": "^1.7.6",
    "@rspack/core": "^1.7.6",
    "@rspack/dev-server": "^1.2.1",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/react-webpack5": "^10.6.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^29.0.0",
    "storybook": "^10.6.0",
    "ts-loader": "^9.5.4",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.0"
  }
}
