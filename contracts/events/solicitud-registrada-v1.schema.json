{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/contracts/events/solicitud-registrada-v1.schema.json",
  "title": "SolicitudRegistrada v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "eventId",
    "occurredAt",
    "aggregateId",
    "type",
    "version",
    "correlationId",
    "estado",
    "categoriaId",
    "categoriaCodigo",
    "categoriaNombre",
    "actorId"
  ],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "occurredAt": { "type": "string", "format": "date-time" },
    "aggregateId": { "type": "string", "format": "uuid" },
    "type": { "const": "SolicitudRegistrada" },
    "version": { "type": "integer", "minimum": 0 },
    "correlationId": { "type": "string", "format": "uuid" },
    "estado": { "const": "REGISTRADA" },
    "categoriaId": { "type": "string", "format": "uuid" },
    "categoriaCodigo": { "type": "string", "minLength": 1, "maxLength": 30 },
    "categoriaNombre": { "type": "string", "minLength": 1, "maxLength": 100 },
    "actorId": { "type": "string", "minLength": 1, "maxLength": 100 }
  }
}
